    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>TEST_SANITY</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>		REG_A 		REG_B 		C_IN		SUM_OUT 		C_OUT 		EN
# Initial test Cout 0; Cin 0
repeat(128)	(n)		(n)		0		(n+n)			0		1
# Initial test Cout 1; Cin 0
repeat(128)	(n+0x8000)	(n+0x8000)	0		((n+n)+0x8000*2)	1		1
# Initial test Cout 1; Cin 1
repeat(128)	(n+0x8000)	(n+0x8000)	1		((n+n)+(0x8000*2)+1)	1		1

# Sample Calculation Test
		20		20		0		40			0		1
		20		20		1		41			0		1
		32768		32767		0		(32768+32767)		0		1
		32768		32767		1		0			1		1
		32768		32768		1		1			1		1</dataString>
          </testData>
        </entry>
      </elementAttributes>
