    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>ROx</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>D_IN		DIR		MODE		C_IN		CLK_IN		EN_OW		EN_OUT		D_OUT		C_OUT
# ROx Case test
let a = 0x3FFF;

(a)		0		0		0		C		1		1		(a)		X	# Initial latch
0		1		0		0		C		1		1		(a&lt;&lt;1)		X	# Rotate to Left
0		1		0		0		C		1		1		(a&lt;&lt;2)		1	# Rotate to Left | Carry test
0		1		0		0		C		1		1		0xFFF9		1	# Rotate to Left | Wrap-Around + Carry test

# Initialize for ROx Case test
let a = 0xFFFC;

(a)		0		0		0		C		1		1		(a)		X	# Initial latch 15bits no Carry
0		2		0		0		C		1		1		(a&gt;&gt;1)		X	# Rotate to Right
0		2		0		0		C		1		1		(a&gt;&gt;2)		1	# Rotate to Right | Carry test
0		2		0		0		C		1		1		0x9FFF		1	# Rotate to Right | Wrap-Around + Carry test</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="1520" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>RCx</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>D_IN		DIR		MODE		C_IN		CLK_IN		EN_OW		EN_OUT		D_OUT		C_OUT
# RCx Case test
let a = 0x7FFE;

# Initialize TREG
(a)		0		0		0		C		1		1		(a)		X

# Test RCL Carry
(a)		1		1		1		C		1		1		0xFFFD		X

# Initialize TREG
(a)		0		0		0		C		1		1		(a)		X

# Test RCR Carry
(a)		2		1		1		C		1		1		0xBFFF		X</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="1360" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>SHx</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>D_IN		DIR		MODE		C_IN		CLK_IN		EN_OW		EN_OUT		D_OUT		C_OUT
# SHx Case test

# Initialize TREG
0xC000		0		0		0		C		1		1		0xC000		X

# Test SHL
0		1		3		0		C		1		1		0x8000		X
0		1		3		0		C		1		1		0x0000		X

# Initialize TREG
3		0		0		0		C		1		1		3		X

# Test SHR
0		2		3		0		C		1		1		1		X
0		2		3		0		C		1		1		0		X</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="1680" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>DFF</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString># This test is to test if Din is equal to Dout
			D_IN		DIR		MODE		C_IN		CLK_IN		EN_OW		EN_OUT		D_OUT		C_OUT
# looptest
loop(b, 16)
let a = random(1&lt;&lt;16);
			(a)		0		0		0		C		1		1		(a)		X
end loop</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="1360" y="-180"/>
    </visualElement>
